.turbo/
node_modules/
apps/desktop/dist-electron/
packages/*/node_modules/
apps/*/node_modules/
ee/apps/*/node_modules/
ee/packages/*/node_modules/
.next/
out/
dist/
packages/*/dist/
apps/*/dist/
ee/apps/*/dist/
ee/packages/*/dist/
ee/apps/inference/models-site/models/api.json
tmp/

# Local git worktrees
_worktrees/
.worktrees/

# Desktop sidecars
apps/desktop/resources/sidecars/
apps/desktop/server/

# Env
.env
.env.*
!.env.example
# Committed local-dev defaults (throwaway secrets) loaded by scripts/dev-local.mjs.
!.env.dev
# The migration-release fragment is committed only on the tagged
# migration-release commit and removed by 03-post-migration-cleanup.mjs.
# Allow git to see it so `cut-migration-release` can commit it.
!.env.migration-release

# Bun build artifacts
*.bun-build
apps/server/cli

# pnpm store (created by Docker volume mounts)
.pnpm-store/

# Docker dev workspace (ephemeral mount point)
packaging/docker/workspace/

# OS
.DS_Store

# OpenCode mirror
vendor/opencode/

# OpenCode local deps
.opencode/node_modules/
.opencode/bun.lock

# OpenWork workspace-local artifacts
.opencode/openwork/
.opencode/agents/openwork.md
.opencode/openwork.json
opencode.jsonc
.vercel
.env*.local
.claude/*
.security
transcript-analysis
# Eval runner output
evals/results/

# drawio-ai-kit integration: ignore local build outputs.
# Users regenerate these from their own build scripts via
# `pnpm drawio:aws:build`; they should NOT be committed unless the user
# explicitly wants the diagram in the repo.
diagrams/aws/*.drawio
diagrams/aws/*.png
diagrams/azure/*.drawio
diagrams/azure/*.png
diagrams/gcp/*.drawio
diagrams/gcp/*.png
diagrams/databricks/*.drawio
diagrams/databricks/*.png
diagrams/bpmn/*.drawio
diagrams/bpmn/*.png
# Smoke-test output from `pnpm drawio:aws:smoke`
diagrams/aws/smoke-*.drawio
